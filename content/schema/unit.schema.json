{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pierre-projects/asl/content/schema/unit.schema.json",
  "title": "Lesson unit",
  "description": "One lesson unit: a list of signs plus optional fingerspelling practice words. See content/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "order", "title", "description", "review", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/$defs/slug" },
    "order": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "review": { "$ref": "#/$defs/review" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    },
    "practice_words": {
      "description": "Words for the fingerspelling drill. Uppercase A-Z only.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]{2,12}$" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "review": {
      "description": "Deaf review status. Content ships as 'draft' until a Deaf signer reviews it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_by"],
      "properties": {
        "status": { "enum": ["draft", "reviewed"] },
        "reviewed_by": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "reviewed" } } },
      "then": { "properties": { "reviewed_by": { "type": "array", "minItems": 1 } } }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gloss", "answer", "kind", "handshape"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "gloss": { "type": "string", "minLength": 1, "description": "Display label, e.g. 'K' or 'MOTHER'." },
        "answer": { "type": "string", "minLength": 1, "description": "What the learner types in receptive drills." },
        "kind": { "enum": ["letter", "number", "sign"] },
        "handshape": { "type": "string", "minLength": 1, "description": "Plain-language description of the handshape." },
        "palm": { "type": "string", "description": "Palm orientation, e.g. 'out', 'toward you', 'down'." },
        "movement": { "type": "string", "description": "Movement, if any. Omit for static signs." },
        "tips": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "confusable_with": {
          "description": "Item ids this sign is commonly confused with; shown as a contrast hint.",
          "type": "array",
          "items": { "$ref": "#/$defs/slug" }
        },
        "media": { "type": "array", "items": { "$ref": "#/$defs/media" } }
      }
    },
    "media": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "type", "credit", "license"],
          "properties": {
            "src": { "type": "string", "pattern": "^media/[A-Za-z0-9_./-]+\\.(png|jpe?g|webp|svg|gif|mp4|webm)$" },
            "type": { "enum": ["image", "video"] },
            "credit": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 },
            "angle": { "enum": ["front", "side", "signer-view"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["embed", "credit"],
          "properties": {
            "embed": { "type": "string", "pattern": "^youtube:[A-Za-z0-9_-]{11}$" },
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "minimum": 0 },
            "credit": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
