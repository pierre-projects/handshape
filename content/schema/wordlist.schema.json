{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wordlist.schema.json",
  "title": "Word list",
  "description": "A list of words a game or drill uses, e.g. the words Sign Five knows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "words"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "length": {
      "description": "When set, every word must have exactly this many letters.",
      "type": "integer",
      "minimum": 1
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]+$" }
    }
  }
}
